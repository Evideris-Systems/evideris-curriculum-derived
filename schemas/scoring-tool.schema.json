{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.evideris.com/derived/schemas/scoring-tool.schema.json",
  "title": "Scoring tool (primary-source — NICE, JNET, Sydney DMI, etc.)",
  "description": "Clinical scoring systems that ESGE curricula reference by name but DEFINE elsewhere in primary publications. Lives in derived layer because the structure is verbatim from the primary citation, NOT the curriculum. SMSA lives in source-canonical (defined in Tate EMR 2023 Table 2).",
  "type": "object",
  "allOf": [{ "$ref": "_common.schema.json#/$defs/envelope" }],
  "required": ["type", "title", "description", "domain", "scale", "inputs"],
  "properties": {
    "type":        { "const": "scoringTool" },
    "title":       { "$ref": "_common.schema.json#/$defs/localeKeyedString" },
    "description": { "$ref": "_common.schema.json#/$defs/localeKeyedString" },
    "domain":      { "type": "string" },
    "scale": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["composite-additive", "ordinal", "categorical", "numeric"] },
        "min":  { "type": "number" },
        "max":  { "type": "number" },
        "bands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label"],
            "properties": {
              "label": { "$ref": "_common.schema.json#/$defs/localeKeyedString" },
              "from":  { "type": "number" },
              "to":    { "type": "number" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "label", "values"],
        "properties": {
          "name":  { "type": "string", "pattern": "^[a-z][a-zA-Z0-9-]*$" },
          "label": { "$ref": "_common.schema.json#/$defs/localeKeyedString" },
          "values": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["label"],
              "properties": {
                "score": { "type": "number" },
                "label": { "$ref": "_common.schema.json#/$defs/localeKeyedString" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "citation"],
        "properties": {
          "id":       { "type": "string" },
          "citation": { "type": "string" },
          "doi":      { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "$schema": true, "$id": true, "lineageId": true, "version": true, "release": true,
    "supersedes": true, "supersededBy": true, "language": true, "_meta": true
  },
  "additionalProperties": false
}
